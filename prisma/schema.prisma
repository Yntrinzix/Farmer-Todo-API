generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  todos     Todo[]
}

model Todo {
  id        String   @id @default(uuid())
  title     String
  state     String   @default("todo") // "todo" | "scheduled" | "done"
  latitude  Float
  longitude Float
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Event sourcing: append-only log of all changes
model Event {
  id          String   @id @default(uuid())
  aggregateId String
  type        String   // "TodoCreated" | "TodoUpdated" | "TodoDeleted"
  data        Json
  userId      String
  createdAt   DateTime @default(now())

  @@index([aggregateId])
  @@index([userId])
}
